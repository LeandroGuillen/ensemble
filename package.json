{
  "name": "ensemble",
  "version": "1.21.1",
  "description": "Character management application for writers and worldbuilders",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "serve": "node scripts/ng-serve.js",
    "start": "node scripts/electron-dev.js",
    "build": "ng build",
    "electron": "electron .",
    "electron-dev": "node scripts/electron-dev.js",
    "electron-dev:test-updates": "ENABLE_UPDATE_TESTING=1 node scripts/electron-dev.js",
    "electron-dev:test-updates-available": "ENABLE_UPDATE_TESTING=1 UPDATE_TEST_SCENARIO=available node scripts/electron-dev.js",
    "electron-dev:test-updates-error": "ENABLE_UPDATE_TESTING=1 UPDATE_TEST_SCENARIO=error node scripts/electron-dev.js",
    "electron-prod": "ng build --configuration production && electron .",
    "build-electron": "ng build --configuration production && electron-builder",
    "build-electron-all": "ng build --configuration production && electron-builder --mac --win --linux",
    "build-electron-mac": "ng build --configuration production && electron-builder --mac",
    "build-electron-win": "ng build --configuration production && electron-builder --win",
    "build-electron-linux": "ng build --configuration production && electron-builder --linux",
    "build-electron-linux-appimage": "ng build --configuration production && electron-builder --linux AppImage",
    "build-electron-linux-deb": "ng build --configuration production && electron-builder --linux deb",
    "build-electron-linux-rpm": "ng build --configuration production && electron-builder --linux rpm",
    "dist": "npm run build-electron-all",
    "build-icons": "node scripts/build-icons.js",
    "prebuild-electron": "npm run build-icons",
    "test:main": "node --test lib/*.test.js",
    "test": "npm run test:main && CHROME_BIN=/usr/bin/chromium ng test --watch=false",
    "verify": "node verify-setup.js",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "keywords": [
    "character-management",
    "worldbuilding",
    "writing",
    "electron",
    "angular"
  ],
  "author": {
    "name": "Leandro Guillen",
    "email": "hi@leandroguillen.com"
  },
  "homepage": "https://github.com/leandroguillen/ensemble",
  "repository": {
    "type": "git",
    "url": "https://github.com/leandroguillen/ensemble.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.13",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/limelight": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poiret-one": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@types/jasmine": "^6.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.19",
    "autoprefixer": "^10.4.22",
    "concurrently": "^8.2.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.0",
    "electron-icon-builder": "^2.0.1",
    "jasmine-core": "^6.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "wait-on": "^7.0.0"
  },
  "dependencies": {
    "@angular/animations": "^21.2.13",
    "@angular/cdk": "^21.2.11",
    "@angular/common": "^21.2.13",
    "@angular/compiler": "^21.2.13",
    "@angular/core": "^21.2.13",
    "@angular/forms": "^21.2.13",
    "@angular/platform-browser": "^21.2.13",
    "@angular/platform-browser-dynamic": "^21.2.13",
    "@angular/router": "^21.2.13",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "chokidar": "^3.5.0",
    "electron-updater": "^6.8.3",
    "js-yaml": "^4.1.0",
    "picomatch": "^4.0.5",
    "remark": "^15.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "unified": "^11.0.0",
    "vis-network": "^9.1.0",
    "zone.js": "~0.15.1"
  },
  "build": {
    "appId": "com.ensemble.app",
    "productName": "Ensemble",
    "copyright": "Copyright © 2025 Ensemble",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "lib/**/*",
      "ipc-channels.json",
      "trash-constants.json",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!node_modules/@angular/cli",
      "!node_modules/@angular-devkit",
      "!node_modules/typescript",
      "!node_modules/electron-builder",
      "!node_modules/concurrently",
      "!node_modules/wait-on"
    ],
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "desktop": {
        "entry": {
          "Name": "Ensemble",
          "Comment": "Character management for writers and worldbuilders",
          "Keywords": "writing;characters;worldbuilding;story;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "alsa-lib"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ensemble"
    },
    "dmg": {
      "title": "Ensemble ${version}",
      "backgroundColor": "#2c3e50",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 190,
          "type": "file"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "leandroguillen",
      "repo": "ensemble"
    }
  },
  "overrides": {
    "baseline-browser-mapping": "^2.10.10"
  }
}
